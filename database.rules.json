{
  "rules": {
    "users_v6": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@sinhala-draughts.app')"
      }
    },
    "publicProfiles_v6": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@sinhala-draughts.app')"
      }
    },
    "usernameIndex_v6": {
      ".read": "auth != null",
      "$username": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid || auth.token.email === 'admin@sinhala-draughts.app')"
      }
    },
    "status_v6": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "invites_v6": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null"
      }
    },
    "rooms_v6": {
      ".read": "auth != null",
      "$roomId": {
        ".write": "auth != null"
      }
    },
    "shopConfig_v6": {
      ".read": true,
      ".write": "auth != null && auth.token.email === 'admin@sinhala-draughts.app'"
    },
    "fcmTokens_v6": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "fcmPushQueue_v6": {
      ".read": false,
      ".write": "auth != null"
    }
  }
}
